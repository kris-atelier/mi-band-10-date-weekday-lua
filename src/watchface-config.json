{
  "name": "Mi Band 10 Date Weekday Lua",
  "device": "Mi Band 10",
  "canvas": { "width": 212, "height": 520, "background": "#000000" },
  "orientation": 90,
  "orientationOptions": [90, 270],
  "display": {
    "date": "YYYY.MM.DD",
    "weekdayLanguage": "en_3char",
    "fontWeight": "bold",
    "dateFont": "Helvetica-Bold",
    "dateFontSize": 40,
    "weekdayFont": "Helvetica-Bold",
    "weekdayFontSize": 80,
    "weekdayColors": {
      "sunday": "#FF3B30",
      "weekday": "#FFFFFF",
      "saturday": "#248BFF"
    },
    "dataRefresh": "dateDay",
    "orientationRule": "90_or_270_only"
  },
  "features": {
    "binaryClock": false,
    "weather": false,
    "messages": false,
    "steps": false,
    "heartRate": false,
    "battery": false
  }
}
